        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo (%1$@); il pacchetto della riunione (%2$@) indica un numero diverso. Nella chiamata vince il pacchetto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilin (%1$@); toplantı paketi (%2$@) farklı bir sayı veriyor. Görüşmede paket geçerli olur."
          }
        }
      }
    },
