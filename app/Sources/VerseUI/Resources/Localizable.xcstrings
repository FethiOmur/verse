            "state": "translated",
            "value": "Verse onsuz da yanıt verir. Profil sayfasında oluştur."
          }
        }
      }
    },
    "Verse can't call Claude until a key is saved again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse non può chiamare Claude finché non viene salvata di nuovo una chiave."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar yeniden kaydedilene kadar Verse Claude’u çağıramaz."
          }
        }
      }
    },
    "Verse could not find its brain: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse non trova il suo cervello: %@"
          }
        },
        "tr": {
